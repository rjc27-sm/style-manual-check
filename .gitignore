# IM2026 Proof Positive entry - everything in im2026 is published.
# These negations override the general excludes above (*.md, Assets/, etc.)
# and must stay at the end of this file.
!im2026/
!im2026/**

# Local test scratch that the mount will not let us unlink; never publish.
im2026/_e2e_tmp.mjs
im2026/_s2_tmp.mjs

# Style Manual content used by Ask. NEVER COMMIT THESE - they must stay out of
# the public repo. The manual is Crown copyright with no open licence, so the
# tool uses the text to produce an answer and does not republish it.
#   pages-content.js  the full page text
#   pages-index.js    the retrieval index, which carries every section heading
# Both are generated by build_pages_index.py from scraped_pages/, and are
# uploaded straight to Cloudflare by `wrangler deploy` without passing through
# git. Regenerate them before deploying the Worker. These rules must stay
# below the !im2026/** negation above, or it will re-include them.
im2026/worker/pages-content.js
im2026/worker/pages-index.js

# Wrangler's local cache. `wrangler dev` and `wrangler deploy` write a fully
# BUNDLED copy of the Worker here - pages-content.js inlined and all - so
# without this rule the !im2026/** negation above would commit the whole
# Style Manual corpus back into the public repo under a new path. Caught
# 17 August 2026 while using `wrangler dev --remote` to test a prompt change.
im2026/worker/.wrangler/

# Local build scripts (source of truth for generated Word docs)
/build_rules_doc.mjs
/build_user_facing_doc.mjs
/build_timeline_deck.cjs
# Regenerates the TRACKED skill reference im2026/skill/.../spellings.md from
# the live dictionary. Added 17 Aug 2026 - the count had been hand-maintained
# and drifted. Run it after any src/spellings.js change.
/build_spellings_md.mjs
# Regenerates skills/au-style-manual-review/references/*.md from the engine.
# Added 21 Aug 2026. Run it after any change to src/rules.js,
# src/list-analysis.js or src/spellings.js, or the skill drifts from the tool.
# (The skill folder itself is already excluded by the *.md rule above.
# Publishing it is a separate decision - see the brief's open question 3.)
/build_skill.mjs
# Usage measurement (22 August 2026). Reads the Analytics Engine SQL API and
# writes monthly summaries. The output carries agency NETWORK NAMES, and the
# script holds an account id, so neither may ever reach this public repo.
# Note .mjs has no general rule here - every local script needs its own line.
/read_analytics.mjs
/analytics/
/.env
